#!/usr/bin/env bash
# tctl osk — toggle, show, hide or query on-screen keyboard state
# Manages wvkbd-deskintl directly via signals + hyprctl dispatch exec
set -euo pipefail

DESCRIPTION="Toggle/show/hide/status on-screen keyboard"

if [[ "${1:-}" == "--describe" ]]; then
  echo "$DESCRIPTION"
  exit 0
fi

usage() {
  echo "Usage: tctl osk <toggle|show|hide|status>" >&2
  exit 1
}

[[ $# -ge 1 ]] || usage

cmd_status() {
  if hyprctl layers -j | jq -e '.. | select(.namespace? == "wvkbd")' >/dev/null 2>&1; then
    echo "visible"
    return 0
  else
    echo "hidden"
    return 1
  fi
}

case "$1" in
  show)
    pkill -USR2 wvkbd-deskintl 2>/dev/null || hyprctl dispatch 'hl.dsp.exec_cmd("wvkbd-deskintl --hidden")' >/dev/null 2>&1 || true
    ;;
  hide)
    pkill -USR1 wvkbd-deskintl 2>/dev/null || true
    ;;
  toggle)
    if cmd_status >/dev/null 2>&1; then
      pkill -USR1 wvkbd-deskintl 2>/dev/null || true
    else
      pkill -USR2 wvkbd-deskintl 2>/dev/null || hyprctl dispatch 'hl.dsp.exec_cmd("wvkbd-deskintl --hidden")' >/dev/null 2>&1 || true
    fi
    ;;
  status)
    cmd_status
    ;;
  *)
    usage
    ;;
esac
