#!/usr/bin/env bash
# tctl notifications — toggle, open, close the notification panel
set -euo pipefail

DESCRIPTION="Toggle/open/close the notification panel"

if [[ "${1:-}" == "--describe" ]]; then
  echo "$DESCRIPTION"
  exit 0
fi

source "$(dirname "$0")/.helpers.sh"

usage() {
  echo "Usage: tctl notifications <toggle|open|close>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  toggle) action="toggle" ;;
  open)   action="open" ;;
  close)  action="close" ;;
  *)      usage ;;
esac

"$TERRASHELL_BIN" ipc call notificationpanel "$action" >/dev/null 2>&1 || true
