#!/usr/bin/env bash
# tctl controlcenter — toggle, open, close the control center / notifications
set -euo pipefail

DESCRIPTION="Toggle/open/close the control center"

if [[ "${1:-}" == "--describe" ]]; then
  echo "$DESCRIPTION"
  exit 0
fi

source "$(dirname "$0")/.helpers.sh"

usage() {
  echo "Usage: tctl controlcenter <toggle|open|close>" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

case "$1" in
  toggle) action="toggle" ;;
  open)   action="open" ;;
  close)  action="close" ;;
  *)      usage ;;
esac

"$TERRASHELL_BIN" ipc call controlcenter "$action" >/dev/null 2>&1 || true
