#!/usr/bin/env bash
# tctl keys [show <submap> | dismiss] — toggle/navigate which-key overlay
set -euo pipefail

DESCRIPTION="Toggle which-key shortcuts overlay"

if [[ "${1:-}" == "--describe" ]]; then
  echo "$DESCRIPTION"
  exit 0
fi

MODE="${1:-}"
SUBMAP="${2:-}"

source "$(dirname "$0")/.helpers.sh"

# NOTE: We use `msg` instead of `ipc call` for the show variant.
# Quickshell's `ipc call` subcommand has a CLI11 bug where it fails to
# accept string arguments (e.g. `qs ipc call whichkey show leader` → error).
# The deprecated `msg` subcommand handles string arguments correctly.
# Bug confirmed: https://git.outfoxxed.me/quickshell/quickshell
# This can be switched back to `ipc call` once the upstream bug is fixed.
echo "$TERRASHELL_BIN"
case "$MODE" in
  show)
    "$TERRASHELL_BIN" msg whichkey show "$SUBMAP" >/dev/null 2>&1 || true
    ;;
  dismiss)
    "$TERRASHELL_BIN" ipc call whichkey dismiss >/dev/null 2>&1 || true
    ;;
  *)
    "$TERRASHELL_BIN" ipc call whichkey toggleLeader >/dev/null 2>&1 || true
    ;;
esac
