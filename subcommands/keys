#!/usr/bin/env bash
# tctl keys — toggle which-key overlay, or dump effective keys config
set -euo pipefail

DESCRIPTION="Toggle which-key shortcuts overlay"

if [[ "${1:-}" == "--describe" ]]; then
  echo "$DESCRIPTION"
  exit 0
fi

case "${1:-}" in
  "")
    terrashell ipc call whichkey toggleLeader >/dev/null 2>&1 || true
    ;;
  dump)
    USER_KEYS="$HOME/.config/terra/keys.json"
    DEFAULT_KEYS="/usr/share/terrashell/keys-defaults.json"

    if [ -f "$USER_KEYS" ]; then
      cat "$USER_KEYS"
    elif [ -f "$DEFAULT_KEYS" ]; then
      cat "$DEFAULT_KEYS"
    else
      echo "tctl keys: no keys config found" >&2
      exit 1
    fi
    ;;
  *)
    echo "Usage: tctl keys [dump]" >&2
    exit 1
    ;;
esac
